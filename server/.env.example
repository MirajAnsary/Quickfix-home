# ===================== QuickFix Home API =====================
# Copy to .env and fill in. NEVER commit .env to git.

NODE_ENV=development
PORT=5000

# Frontend origin(s) allowed by CORS, comma separated
CLIENT_URL=http://localhost:5173

# MongoDB (local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/quickfix_home

# ---- Secrets: each at least 32 random characters, all DIFFERENT ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
OTP_HMAC_SECRET=
RESET_TOKEN_SECRET=
JWT_EXPIRES_IN=7d

# Cookie SameSite: "lax" when frontend and API are on the same site (recommended).
# Use "none" only if they are on different domains (requires HTTPS).
COOKIE_SAMESITE=lax

# ---- OTP rules ----
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_HOUR=5
# Development ONLY: print OTP to the server console when no email/SMS provider is set.
# The server refuses to start if this is true while NODE_ENV=production.
DEV_LOG_OTP=false

# ---- Email OTP (SMTP). Works with Gmail App Password, Brevo, Zoho, SES, etc. ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="QuickFix Home <no-reply@yourdomain.in>"

# ---- SMS OTP (optional). SMS_PROVIDER = fast2sms | twilio | (empty = off) ----
# India: commercial SMS needs DLT registration with your telecom operator.
SMS_PROVIDER=
FAST2SMS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---- Razorpay (optional; online payment disabled when empty) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# GST % added to invoices (0 if you are not GST registered)
GST_RATE_PERCENT=0

# ---- Seed script (npm run seed) ----
SEED_ADMIN_NAME=QuickFix Admin
SEED_ADMIN_EMAIL=
SEED_ADMIN_PHONE=
SEED_ADMIN_PASSWORD=
