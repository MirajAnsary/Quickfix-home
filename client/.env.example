# ---- QuickFix Home frontend ----
# Only PUBLIC values belong here. Everything with VITE_ is bundled into the browser code.
# Never put JWT secrets, OTP secrets, SMTP passwords or Razorpay key SECRET in this file.

# true  = DEMO MODE: no backend, sample data, nothing saved (yellow banner is shown)
# false = LIVE MODE: all calls go to the Express API
VITE_USE_MOCK=false

# API base path. Keep "/api" in development (Vite proxies it to the backend).
# In production, use "/api" behind the same domain, or the full API URL.
VITE_API_URL=/api

# Where the Vite dev server forwards /api requests
VITE_API_PROXY=http://localhost:5000

# Public contact details shown on the site (replace with your REAL numbers before launch)
VITE_SUPPORT_PHONE=+91 82509 12345
VITE_SUPPORT_EMAIL=support@quickfixhome.in
VITE_SUPPORT_WHATSAPP=918250912345
